# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/land_registry_db
MONGODB_URI_TEST=mongodb://localhost:27017/land_registry_test_db

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this
JWT_REFRESH_EXPIRE=7d

# Bcrypt Configuration
BCRYPT_ROUNDS=12

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@landregistry.go.ke

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Encryption Key for Documents
DOCUMENT_ENCRYPTION_KEY=your_256_bit_encryption_key_change_this

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# System Configuration
SESSION_TIMEOUT_MINUTES=30
PASSWORD_RESET_EXPIRE_HOURS=1
AUDIT_RETENTION_DAYS=3650
BACKUP_RETENTION_DAYS=30
